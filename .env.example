# Upstash Redis — agent-fetch logging + rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Owner-bypass cookie for the dashboard (any long random string)
ANCHOR_ADMIN_KEY=

# Anthropic — comparison agent (Edge AI Gateway optional later)
ANTHROPIC_API_KEY=

# Daily USD spend cap across both LLM endpoints (/api/ask + /compare).
# UTC-reset. Default $2/day. Charged in cents, fails CLOSED once hit.
ANCHOR_DAILY_USD_CAP=2

# Per-IP request cap, sliding 1-hour window. Default 10/hour. The
# owner-bypass cookie skips this; everyone else shares the bucket.
ANCHOR_PER_IP_HOURLY=10

# Canonical site origin (used in citation-shaped responses and agents.json)
ANCHOR_ORIGIN=https://anchor.kevinmurphywebdev.com
